# Copy to .env and adjust. Defaults run everything on a laptop with mock providers.

# --- AI providers -----------------------------------------------------------
ASR_PROVIDER=mock                 # mock | indic_conformer_http
ASR_BASE_URL=                     # e.g. http://127.0.0.1:9000 (services/asr/run.sh on this server)
ASR_LANGUAGE=hi                   # speech language code (IndicConformer has no English)
LLM_PROVIDER=mock                 # mock | openai_compatible | hosted
LLM_BASE_URL=                     # e.g. http://gpu-host:8001/v1 (vLLM) or http://localhost:11434/v1 (Ollama)
LLM_MODEL=                        # e.g. Qwen/Qwen2.5-VL-7B-Instruct
LLM_API_KEY=                      # only if the endpoint requires one
TTS_PROVIDER=browser              # browser | mock | server
HOSTED_LLM_ALLOWED=false          # hosted APIs may only ever see synthetic encounters
LLM_REWRITE_OUTPUTS=false         # optional fluency rewrite of outputs (checked; template fallback)

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///./sehat.db
AUDIO_RETENTION=delete_on_confirm # delete_on_confirm | keep_days:N  (purge: python -m app.jobs.purge_audio)

# --- Accounts and privacy -----------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
AUDIO_ENCRYPTION_KEY=             # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
                                  # without it, audio is never written to disk (transcription still works)
ENCOUNTER_RETENTION_DAYS=365      # purge: python -m app.jobs.purge_records

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
