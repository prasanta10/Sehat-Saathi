{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sehat-saathi.local/schemas/reference.schema.json",
  "title": "Official source reference",
  "type": "object",
  "required": ["id", "title", "publisher", "url", "version_or_date", "retrieved_on", "jurisdiction", "kind", "excerpts"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "url": {"type": "string", "pattern": "^https://"},
    "version_or_date": {"type": "string", "minLength": 1},
    "retrieved_on": {"$ref": "common.schema.json#/$defs/date"},
    "jurisdiction": {"type": "string", "pattern": "^(national|[A-Z]{2})$"},
    "kind": {"enum": ["clinical_guidance", "scheme", "helpline", "directory"]},
    "excerpts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["locator", "text"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "local_copy": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
